{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "mcp__Notion",
      "Bash(xvfb-run:*)",
      "Bash(HEADER_TEXT=*)",
      "Bash(cd:*)",
      "Bash(rm:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/restore-max-profile.sh"
          }
        ]
      }
    ]
  }
}
